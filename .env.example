# Optional but strongly recommended: authenticates scripts/scrape_reddit.py against
# the official Reddit API instead of the anonymous public JSON endpoints.
#
# Anonymous reddit.com JSON is the most aggressively throttled way to read Reddit,
# which is what pushes a long sweep down into the HTML and billable Firecrawl tiers
# (and eventually into outright 403s). A registered script app reads oauth.reddit.com
# at a far higher sanctioned rate, so most sweeps never need a fallback tier at all.
#
# Manage apps at https://www.reddit.com/prefs/apps. Two app types work, and the
# scraper picks the right OAuth grant automatically based on what you fill in:
#
#   script / web app  -> set BOTH id and secret (uses the client_credentials grant)
#   installed app     -> set ONLY the id, leave the secret blank; installed apps are
#                        public clients and have no secret (uses the installed_client
#                        grant). Useful because Reddit now gates new app registration,
#                        so an older installed app may be the only client you have.
#
#   client id     = the string under the app name
#   client secret = the "secret" field (script/web apps only)
#
# The scraper still works without either, just slower and more fallback-prone.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional. Only used by the installed-app grant, which requires a device id.
# Defaults to Reddit's documented opt-out value, which is what a crawler wants.
REDDIT_DEVICE_ID=

# Optional: enables Firecrawl as a last-resort fallback (tier 3) in scripts/scrape_reddit.py,
# used only when both the reddit.com JSON API and old.reddit.com HTML parsing fail.
# Get a key at https://www.firecrawl.dev - the scraper works fine without one.
FIRECRAWL_API_KEY=
