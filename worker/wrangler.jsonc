{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "og-rep-hub-issue-intake",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://dusd24.github.io",
    "ALLOWED_TURNSTILE_HOSTNAME": "dusd24.github.io",
    "GITHUB_REPOSITORY": "DusD24/og-rep-hub",
    "BUILD_SHA": "development"
  },
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "2408081",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
